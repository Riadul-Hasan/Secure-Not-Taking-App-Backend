# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string.
# Replace <URL_ENCODED_PASSWORD> with the URL-encoded password of the
# SecureNoteDB Atlas user. This file is git-ignored — never commit real
# credentials. Copy .env.example and fill in the values locally.
MONGO_URI=mongodb+srv://SecureNoteDB:<URL_ENCODED_PASSWORD>@cluster0.nttz9vg.mongodb.net/secure_notes?retryWrites=true&w=majority

# ---- Auth ----
# Use a long, random value in production: e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
